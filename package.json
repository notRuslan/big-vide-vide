{
  "name": "big-vibe-vide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd apps/frontend && npm run dev",
    "dev:full": "concurrently \"cd apps/frontend && npm run dev\" \"cd apps/backend && npm run dev\"",
    "build": "cd apps/frontend && npm run build",
    "install:all": "cd apps/frontend && npm install && cd ../backend && npm install",
    "start": "cd apps/backend && npm start",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/e2e",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/unit",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jsdom": "^30.1.0",
    "jsonwebtoken": "^9.0.3",
    "sql.js": "^1.14.2",
    "supertest": "^7.2.2"
  }
}
